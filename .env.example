# RAG System Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_PATH=./data/chroma_db
LLAMA_MODEL_PATH=./models/llm/Phi-3.5-mini-instruct.Q4_K_M.gguf

# Model Cache Paths (for self-sustainability)
SENTENCE_TRANSFORMERS_HOME=./models/embedding
TRANSFORMERS_CACHE=./models/embedding

# LLM Providers Configuration
# Ollama Configuration
# NOTE: this must be a real Ollama library tag (lowercase), not an HF repo name.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi4-mini

# Any other OpenAI-compatible server: llama-server (llama.cpp) or LM Studio.
# Use the BARE origin -- the /v1 suffix is added for you.
# llama-server ignores OPENAI_COMPAT_MODEL; LM Studio needs the loaded model id.
OPENAI_COMPAT_BASE_URL=http://localhost:8080
OPENAI_COMPAT_MODEL=local-model

# DeepSeek Configuration
DEEPSEEK_MODEL=deepseek-chat
# Alternative: deepseek-reasoner

# Retrieval Settings
TOP_K_RETRIEVAL=3  # Uncomment and set value to enable
# SIMILARITY_THRESHOLD=0.7  # Currently not used with ChromaDB, will be enabled with weaviate support

# Logging
LOG_LEVEL=WARN
LOG_FILE=./logs/rag_demo.log
